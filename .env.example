# Database Configuration for Image Matcher
# Copy this file to .env and fill in your database credentials

# PostgreSQL/Supabase Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chebichat
DB_USER=postgres
DB_PASSWORD=your_password_here

# For Supabase, use these instead:
# DB_HOST=db.your-project.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password

# Processing Options
BATCH_SIZE=10
MAX_ENTRIES=
DRY_RUN=false
